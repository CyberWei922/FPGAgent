# 复制为 .env.local 并填入测试 Key（.env.local 已被 .gitignore 忽略，绝不提交）
# 供 createLLMClient({ mode: 'node' }) 在 Vitest / 命令行中使用，也是站点云函数的环境变量参考

# 主渠道（阿里云百炼，优先使用）
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3.8-flash
# 可选：站点默认下拉允许切换的模型白名单（逗号分隔）
LLM_MODELS=qwen3.8-flash,deepseek-v4.1-flash

# 备用渠道（AMD Radeon Cloud Token Factory，主渠道限流/异常时自动切换）
FALLBACK_LLM_API_KEY=
FALLBACK_LLM_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
# 可选：不填时会自动按请求模型映射到 Qwen3.8-Flash-Next / DeepSeek-V4.1-Flash-1017
FALLBACK_LLM_MODEL=

# 每日免费额度限制（按 IP 与浏览器双重限制，均默认 8 次/天）
DAILY_LIMIT_PER_IP=8
DAILY_LIMIT_PER_BROWSER=8
