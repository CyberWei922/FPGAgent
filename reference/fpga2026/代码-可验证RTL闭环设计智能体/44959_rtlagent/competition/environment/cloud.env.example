# Copy to competition/config/cloud.local.env, fill the local paths, then source
# that file in a Linux terminal before serve/start.sh. Never commit the token.
export FPGACHINA_TOKEN='REPLACE_WITH_YOUR_TOKEN'
# Competition cloud uses Q6. Q4 belongs to the local development scripts.
export MODEL_NAME='qwen3.8-27b-q6-cloud'
export MODEL_PATH='/workspace/models/Qwen3.8-27B-UD-Q6_K_M.gguf'
# If the platform mounts this exact Q6 file, point MODEL_PATH to its verified
# absolute location under /models; the same identity and byte checks apply.
export LLAMA_SERVER_BIN='/opt/llamacpp/llama-server'
export ROCBLAS_TENSILE_LIBPATH='/opt/llamacpp/rocblas/library'
export SERVING_BACKEND='llama.cpp'
export VIVADO_MCP_BACKEND='fixed_persistent'
export ROSS_MCP_BIN="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)/vendor/ross/vivado-mcp-server-linux-amd64-2026.9.1"
# Export with --ross-binary to include the verified Linux standalone program.
# Explicit alternatives: fixed (original custom), amd_ross (official); no silent fallback.
export PYTHON_BIN='python3'
export MAX_MODEL_LEN='32768'
export LLM_MAX_TOKENS='8192'
export AGENT_DEADLINE_S='900'
export XILINXD_LICENSE_FILE="${XILINXD_LICENSE_FILE:-2100@vivado-lic.fpgachina.svc.cluster.local}"
export FLEXLM_TIMEOUT="${FLEXLM_TIMEOUT:-300000000}"
export EDA_TMP='/var/tmp/eda'
export AGENT_TMP='/var/tmp'
export SELFTEST_TMP='/var/tmp'
export TMPDIR='/var/tmp'
export SERVICE_STATE_DIR='/var/tmp/rtl-agent-service'
export OMP_NUM_THREADS='16'
# Store private settings in /workspace/env.sh or another persistent file.
# Keep XILINX_VIVADO/XILINX_VITIS from the organizer's image.
# With XILINX_VITIS=/tools/Xilinx/2026.1/Vitis, locate the sibling Vivado/bin.
# Do not add the old Windows ROCm 7.14 directory to a cloud library path.

# Observed official W7900D image differs from the older PPT llama.cpp build.
# The separate profile pins its actual build and binary SHA256; no silent bypass.
export RTL_ENVIRONMENT_PROFILE="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/versions-cloud-w7900d-20261017.json"
